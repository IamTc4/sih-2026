# Copy to .env and fill in values.

# --- Tronscan API ---
# Public endpoint — no key required for basic use.
# Upgrade to a paid key for higher rate limits in production.
TRONSCAN_API_BASE=https://apilist.tronscanapi.com/api
TRONSCAN_API_KEY=

# --- Traversal limits ---
# Maximum BFS hops from the seed address. 6 is safe for live demo speed.
# Raise to 10+ for deeper production investigations.
MAX_HOP_DEPTH=6

# Max transactions fetched per address per hop (Tronscan page size).
MAX_TX_PER_ADDRESS=50

# Deposit-reuse clustering: two addresses that both forward funds to the same
# collector within this many seconds are merged into one cluster.
CLUSTER_TIME_WINDOW_SEC=3600

# Minimum fraction of total outflow for an edge to be the "majority" path
# (peel-chain vs bulk-flow distinction).
MAJORITY_FLOW_THRESHOLD=0.5

# --- Agentic AI module URL (for integration) ---
# This is the URL where the Agentic AI orchestration service is running.
AGENTIC_AI_URL=http://localhost:8000
