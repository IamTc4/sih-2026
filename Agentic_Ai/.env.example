# Copy this file to .env and fill in your values.
# The agent currently works with Google Gemini or OpenAI.
# Set exactly ONE of GOOGLE_API_KEY or OPENAI_API_KEY.

# --- LLM Provider ---
GOOGLE_API_KEY=your-google-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# --- Agent Behaviour ---
# Minimum attribution confidence required to auto-draft a legal notice.
# Below this threshold the graph routes to RecommendManualReview instead.
# Range: 0.0 – 1.0   Default: 0.75
CONFIDENCE_THRESHOLD=0.75

# --- LLM Model Selection ---
# Google: "gemini-1.5-pro" | "gemini-1.5-flash"
# OpenAI: "gpt-4o" | "gpt-4o-mini"
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1

# --- Integration: Blockchain Analytics Module (port 8000 new / 8001 old) ---
# Set to the URL where the Blockchain module is running.
# Leave empty to use deterministic mocks (safe for isolated Agentic AI tests).
BLOCKCHAIN_API_URL=http://localhost:8000

# --- Integration: ML Risk Scoring Module (port 8002) ---
# Set to the URL where the ML module is running (cd ML && python main.py).
# Leave empty to use the deterministic mock risk scorer.
ML_API_URL=http://localhost:8002

# --- Integration: Cybersecurity Module (port 8003) ---
# Set to the URL where the Cybersecurity module is running.
# Leave empty to use the deterministic mock blacklist / log stubs.
CYBERSECURITY_API_URL=http://localhost:8003
