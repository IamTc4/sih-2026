# ============================================================
# CryptoSentinel — Environment Configuration EXAMPLE
# Copy to .env.docker and fill in real values:
#   cp .env.example .env.docker
#   nano .env.docker
# ============================================================

# ---- Blockchain Service (port 8000) ----
# Set USE_MOCK_DATA=true to use built-in mock data (no API key needed)
# Set USE_MOCK_DATA=false to use live TronGrid API (requires TRONGRID_API_KEY)
USE_MOCK_DATA=true
TRONGRID_API_KEY=YOUR_TRONGRID_API_KEY_HERE
TRON_GRID_BASE_URL=https://api.trongrid.io
TRONSCAN_BASE_URL=https://apilist.tronscanapi.com/api
MAX_TRANSACTIONS_PER_WALLET=50
MAX_HOPS=4
FLOW_THRESHOLD_PERCENT=10.0
MIN_USDT_AMOUNT=1.0

# ---- Agentic AI Service (port 8001) ----
# Provide one LLM API key:
GOOGLE_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1
CONFIDENCE_THRESHOLD=0.75

# ---- ML Risk Scoring Service (port 8002) ----
MODEL_PATH=ml/data/model.pkl
HIGH_CONFIDENCE_THRESHOLD=0.75
MEDIUM_CONFIDENCE_THRESHOLD=0.45
BEHAVIORAL_SIMILARITY_THRESHOLD=0.85

# ---- Inter-Service URLs (auto-resolved by Docker networking) ----
BLOCKCHAIN_API_URL=http://blockchain:8000
ML_API_URL=http://ml-risk:8002
CYBERSECURITY_API_URL=http://cybersecurity:8003
