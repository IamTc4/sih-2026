# ============================================================
# WalletTrace ML Risk Scoring Module — Configuration (.env)
# ============================================================

# ---- Server ----
HOST=0.0.0.0
PORT=8002
DEBUG_MODE=true

# ---- Upstream services (used to call real APIs if available) ----
BLOCKCHAIN_API_URL=http://localhost:8000
CYBERSECURITY_API_URL=http://localhost:8003

# ---- Model settings ----
# Path to trained model file (relative to ML/ directory)
MODEL_PATH=ml/data/model.pkl

# Risk score threshold above which the model reports "high" confidence
HIGH_CONFIDENCE_THRESHOLD=0.75
MEDIUM_CONFIDENCE_THRESHOLD=0.45

# ---- Behavioral clustering ----
# Cosine similarity threshold to flag behavioral similarity
BEHAVIORAL_SIMILARITY_THRESHOLD=0.85
