{
  "rewrites": [
    {
      "source": "/api/blockchain/:path*",
      "destination": "https://solaris-launch-offshore-webcast.trycloudflare.com/api/blockchain/:path*"
    },
    {
      "source": "/api/agent/:path*",
      "destination": "https://solaris-launch-offshore-webcast.trycloudflare.com/api/agent/:path*"
    },
    {
      "source": "/api/ml/:path*",
      "destination": "https://solaris-launch-offshore-webcast.trycloudflare.com/api/ml/:path*"
    },
    {
      "source": "/api/cyber/:path*",
      "destination": "https://solaris-launch-offshore-webcast.trycloudflare.com/api/cyber/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ]
}
